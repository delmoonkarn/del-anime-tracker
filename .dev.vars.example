# Optional secrets for `npm run cf:dev` (wrangler dev). Copy to .dev.vars and
# fill in; .dev.vars is gitignored. On Cloudflare, set one with:
#   npx wrangler secret put NAME
# All of them can stay empty: backup email is set up from the Settings page.

# A code that first-run account setup asks for, so nobody else can create the
# account on a fresh deploy. Any long random string.
SETUP_CODE=

# Backup email the old way. The Settings page does the same and is easier;
# if these are set, they're copied into Settings the first time it's opened.
# resend.com > API Keys. Without your own domain on Resend, emails can only
# go to the address you signed up to Resend with, so use that here.
RESEND_API_KEY=
BACKUP_EMAIL_TO=
# Only with a domain verified on Resend, e.g. Anime Tracker <backup@yourdomain.com>
BACKUP_EMAIL_FROM=
