# Secrets for `npm run cf:dev` (wrangler dev). Copy to .dev.vars and fill in;
# .dev.vars is gitignored. On Cloudflare, set each with:
#   npx wrangler secret put NAME

# Unlocks first-run account setup. Any long random string.
SETUP_CODE=

# Optional: backup emails (monthly on Cloudflare, plus "Email backup now").
# resend.com > API Keys. Without your own domain on Resend, emails can only
# go to the address you signed up to Resend with, so use that here.
RESEND_API_KEY=
BACKUP_EMAIL_TO=
# Only with a domain verified on Resend, e.g. Anime Tracker <backup@yourdomain.com>
BACKUP_EMAIL_FROM=
