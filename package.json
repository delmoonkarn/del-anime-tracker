{
  "name": "anime-tracker",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-server.mjs",
    "preview": "vite preview",
    "start": "node dist-server/index.cjs",
    "build-exe": "node scripts/build-exe.mjs",
    "cf:db:local": "wrangler d1 migrations apply anime-tracker --local",
    "cf:seed:local": "tsx scripts/export-sql.ts .wrangler/seed.sql && wrangler d1 execute anime-tracker --local --file .wrangler/seed.sql",
    "cf:dev": "vite build && wrangler dev",
    "restore": "tsx scripts/restore.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.3",
    "better-sqlite3": "^11.3.0",
    "exceljs": "^4.4.0",
    "hono": "^4.6.9",
    "lucide-react": "^0.408.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@yao-pkg/pkg": "^6.20.0",
    "autoprefixer": "^10.4.19",
    "esbuild": "^0.28.0",
    "postcss": "^8.4.39",
    "rcedit": "^5.0.2",
    "tailwindcss": "^3.4.6",
    "tsx": "^4.19.2",
    "typescript": "^5.5.3",
    "vite": "^5.4.10",
    "wrangler": "^4.151.3"
  }
}
